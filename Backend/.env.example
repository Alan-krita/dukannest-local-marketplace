# Database Configuration
# Format: postgresql+psycopg://[user]:[password]@[host]:[port]/[database]?sslmode=require
# For Supabase, copy your connection URI from: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Make sure the scheme prefix is "postgresql+psycopg://"
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# JWT Authentication Configuration
JWT_SECRET=generate-a-strong-secret-key-here-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
